{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framebatch",
  "version": "0.9.0",
  "identifier": "com.framebatch.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Framebatch \u2014 Process Multiple Files",
        "width": 1480,
        "height": 940,
        "theme": "Dark",
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        {
          "identifier": "main",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "dialog:allow-open",
            "core:window:allow-close",
            "core:window:allow-destroy",
            "core:window:allow-set-theme"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
